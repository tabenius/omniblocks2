{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/preview/[...slug]",
      "regex": "^/preview/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/preview/(?<nxtPslug>.+?)(?:/)?$"
    },
    {
      "page": "/preview-email/[...slug]",
      "regex": "^/preview\\-email/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/preview\\-email/(?<nxtPslug>.+?)(?:/)?$"
    },
    {
      "page": "/slug/edit/[...slug]",
      "regex": "^/slug/edit/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/slug/edit/(?<nxtPslug>.+?)(?:/)?$"
    },
    {
      "page": "/slug/[...slug]",
      "regex": "^/slug/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/slug/(?<nxtPslug>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/contacts",
      "regex": "^/api/contacts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/contacts(?:/)?$"
    },
    {
      "page": "/api/email/send",
      "regex": "^/api/email/send(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/email/send(?:/)?$"
    },
    {
      "page": "/api/r2/images",
      "regex": "^/api/r2/images(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/r2/images(?:/)?$"
    },
    {
      "page": "/api/r2/object",
      "regex": "^/api/r2/object(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/r2/object(?:/)?$"
    },
    {
      "page": "/api/r2/startup",
      "regex": "^/api/r2/startup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/r2/startup(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/preview",
      "regex": "^/preview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/preview(?:/)?$"
    },
    {
      "page": "/preview-email",
      "regex": "^/preview\\-email(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/preview\\-email(?:/)?$"
    },
    {
      "page": "/style-editor",
      "regex": "^/style\\-editor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/style\\-editor(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}